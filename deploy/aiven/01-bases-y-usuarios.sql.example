-- =====================================================================================================
-- BioHub - Aprovisionamiento UNICO de MySQL administrado en Aiven (bases y usuarios).
--
-- Quien lo ejecuta: una sola persona, UNA vez, con el usuario administrador del servicio (avnadmin).
-- Alcance: servicios de Juanita. servicio-cientifico (esquema `cientifico`, compartido con el modulo
--          registro de Hernando) y servicio-consulta-publica (esquema `consulta_publica`).
--
-- COMO USARLO (este archivo es una PLANTILLA; la copia con contrasenas reales NO se sube a git:
-- deploy/aiven/.gitignore ignora 01-bases-y-usuarios.sql):
--   1) cp 01-bases-y-usuarios.sql.example 01-bases-y-usuarios.sql
--   2) Reemplaza cada marcador CAMBIAR_... por una contrasena distinta y aleatoria. Usa solo [A-Za-z0-9]
--      para no tener que escapar comillas:   openssl rand -hex 24
--      Comprueba que no quedo ninguno:       grep -n CAMBIAR_ 01-bases-y-usuarios.sql   (debe salir vacio)
--   3) Ejecuta con SSL verificado (ca.pem se descarga de la consola de Aiven, pestana "Overview"):
--        mysql --ssl-mode=VERIFY_CA --ssl-ca=ca.pem -h <HOST> -P <PUERTO> -u avnadmin -p < 01-bases-y-usuarios.sql
--      (la contrasena de avnadmin se escribe en el prompt; no la pases por argumento).
--   4) Guarda las contrasenas en el .env de cada servicio (nunca en git) y borra la copia con claves.
--
-- Es IDEMPOTENTE: repetirlo no duplica nada y vuelve a fijar contrasenas y permisos (sirve para rotar).
-- No contiene DROP ni TRUNCATE. avnadmin no tiene SUPER en Aiven y este script no lo necesita.
--
-- Usuarios (cuatro) y variables de entorno que alimentan application*.yml:
--   cientifico_app      DML    CIENTIFICO_DB_USER   / CIENTIFICO_DB_PASSWORD    (conexion de la aplicacion)
--   cientifico_migr     DDL    CIENTIFICO_MIGR_USER / CIENTIFICO_MIGR_PASSWORD  (solo Flyway, SEC-11)
--   consulta_app        DML    CONSULTA_DB_USER     / CONSULTA_DB_PASSWORD
--   consulta_migr       DDL    CONSULTA_MIGR_USER   / CONSULTA_MIGR_PASSWORD
-- Si no defines *_MIGR_USER, Flyway usa el usuario de la aplicacion y, al no tener DDL, la migracion falla.
--
-- Decisiones:
--  * Charset utf8mb4 / collation utf8mb4_0900_ai_ci en la BASE, de modo que flyway_schema_history
--    (que Flyway crea sin charset propio) y cualquier tabla futura hereden lo mismo que las migraciones.
--  * Un usuario por servicio y base: cientifico_* no ve consulta_publica ni al reves (aislamiento de
--    D4/D14: las coordenadas viven solo en `cientifico`, cifradas, y `consulta_publica` no las tiene).
--  * Host '%': Aiven no ofrece IP fija para los clientes. El control de red se hace en Aiven con la lista de
--    IP permitidas del servicio (Allowed IP addresses). REQUIRE SSL rechaza conexiones sin TLS.
--  * El usuario de aplicacion NO tiene CREATE/ALTER/DROP/INDEX/REFERENCES: si se vulnera el servicio, no puede
--    cambiar el esquema. Los permisos son sobre la base entera (`cientifico`.*): cubren tablas futuras sin
--    volver a ejecutar este script.
--  * Sin GRANT OPTION, sin FILE, sin PROCESS, sin SUPER, sin TRIGGER, sin EXECUTE/rutinas.
-- =====================================================================================================

-- ---------- Bases ----------
CREATE DATABASE IF NOT EXISTS `cientifico`
  CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE DATABASE IF NOT EXISTS `consulta_publica`
  CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
-- Si la base ya existia con otro charset, se corrige aqui (no toca las tablas existentes):
ALTER DATABASE `cientifico`       CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
ALTER DATABASE `consulta_publica` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;

-- ---------- Usuarios: se crean y SIEMPRE se les vuelve a fijar la contrasena (idempotente) ----------
CREATE USER IF NOT EXISTS 'cientifico_app'@'%'  IDENTIFIED BY 'CAMBIAR_CIENTIFICO_APP_PASSWORD'  REQUIRE SSL;
CREATE USER IF NOT EXISTS 'cientifico_migr'@'%' IDENTIFIED BY 'CAMBIAR_CIENTIFICO_MIGR_PASSWORD' REQUIRE SSL;
CREATE USER IF NOT EXISTS 'consulta_app'@'%'    IDENTIFIED BY 'CAMBIAR_CONSULTA_APP_PASSWORD'    REQUIRE SSL;
CREATE USER IF NOT EXISTS 'consulta_migr'@'%'   IDENTIFIED BY 'CAMBIAR_CONSULTA_MIGR_PASSWORD'   REQUIRE SSL;

ALTER USER 'cientifico_app'@'%'  IDENTIFIED BY 'CAMBIAR_CIENTIFICO_APP_PASSWORD'  REQUIRE SSL WITH MAX_USER_CONNECTIONS 20;
ALTER USER 'cientifico_migr'@'%' IDENTIFIED BY 'CAMBIAR_CIENTIFICO_MIGR_PASSWORD' REQUIRE SSL WITH MAX_USER_CONNECTIONS 3;
ALTER USER 'consulta_app'@'%'    IDENTIFIED BY 'CAMBIAR_CONSULTA_APP_PASSWORD'    REQUIRE SSL WITH MAX_USER_CONNECTIONS 20;
ALTER USER 'consulta_migr'@'%'   IDENTIFIED BY 'CAMBIAR_CONSULTA_MIGR_PASSWORD'   REQUIRE SSL WITH MAX_USER_CONNECTIONS 3;

-- ---------- Permisos: se recalculan desde cero (REVOKE + GRANT) para corregir desviaciones ----------
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'cientifico_app'@'%';
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'cientifico_migr'@'%';
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'consulta_app'@'%';
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'consulta_migr'@'%';

-- Aplicacion: solo DML.
GRANT SELECT, INSERT, UPDATE, DELETE ON `cientifico`.*       TO 'cientifico_app'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE ON `consulta_publica`.* TO 'consulta_app'@'%';

-- Migracion (Flyway): DML (para flyway_schema_history y los INSERT de catalogos) + DDL de tablas e indices.
-- DROP se concede porque una migracion futura puede eliminar una columna/indice/tabla; cada migracion se
-- revisa en el PR. Sin TRIGGER, sin CREATE ROUTINE/EVENT: Aiven no da SUPER y con binlog activo exigirian
-- log_bin_trust_function_creators (ver docs/equipo/05-modelo-datos.md, seccion Aiven).
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES
  ON `cientifico`.*       TO 'cientifico_migr'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES
  ON `consulta_publica`.* TO 'consulta_migr'@'%';

-- Verificacion: deben listarse exactamente estos permisos, sin ALL PRIVILEGES ni WITH GRANT OPTION.
SHOW GRANTS FOR 'cientifico_app'@'%';
SHOW GRANTS FOR 'cientifico_migr'@'%';
SHOW GRANTS FOR 'consulta_app'@'%';
SHOW GRANTS FOR 'consulta_migr'@'%';

-- Nota: Aiven aplica los cambios de usuarios al instante; FLUSH PRIVILEGES no es necesario con GRANT/CREATE USER.
