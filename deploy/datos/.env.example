# =============================================================================
# BioHub - VM biohub-datos (4 instancias MySQL 8.4)
# Normalmente NO se edita a mano: deploy/generar-env.sh crea este archivo con
# contraseñas aleatorias y deploy/desplegar.sh rellena TS_IP_*.
# Sin ${...}. Solo caracteres [A-Za-z0-9_] en usuarios y contraseñas.
# =============================================================================
COMPOSE_PROJECT_NAME=biohub-datos

# IP de Tailscale (100.x.y.z) de ESTA VM: los puertos MySQL se publican solo ahi.
# Se obtiene con `tailscale ip -4` en biohub-datos.
TS_IP_DATOS=
# IP de Tailscale de biohub-backend: unico origen permitido para los usuarios de aplicacion.
TS_IP_BACKEND=

# Puertos publicados en TS_IP_DATOS
MYSQL_TRANSACCIONAL_PORT=3307
MYSQL_LECTURA_PORT=3308
MYSQL_ANALITICA_PORT=3309
MYSQL_GATEWAY_PORT=3310

# Contraseñas de root (solo uso local dentro de la VM)
MYSQL_TRANSACCIONAL_ROOT_PASSWORD=cambiar_root_transaccional
MYSQL_LECTURA_ROOT_PASSWORD=cambiar_root_lectura
MYSQL_ANALITICA_ROOT_PASSWORD=cambiar_root_analitica
MYSQL_GATEWAY_ROOT_PASSWORD=cambiar_root_gateway

# Usuarios de aplicacion. IMPORTANTE: estas contraseñas deben ser IDENTICAS
# a las de deploy/backend/.env (generar-env.sh ya las escribe iguales en ambos).
MYSQL_CIENTIFICO_USER=cientifico_app
MYSQL_CIENTIFICO_PASSWORD=cambiar_cientifico
MYSQL_EQUIPOS_USER=equipos_app
MYSQL_EQUIPOS_PASSWORD=cambiar_equipos
MYSQL_LECTURA_USER=consulta_app
MYSQL_LECTURA_PASSWORD=cambiar_lectura
MYSQL_ANALITICA_USER=reportes_app
MYSQL_ANALITICA_PASSWORD=cambiar_analitica
MYSQL_GATEWAY_USER=gateway_app
MYSQL_GATEWAY_PASSWORD=cambiar_gateway

# Copias de seguridad (backup/backup.sh)
BACKUP_DIR=/var/backups/biohub
BACKUP_RETENCION_DIAS=14
