// Politica de acceso (ACL) de la tailnet tailcfd75e.ts.net - BioHub.  SEC-D-01 / SEC-D-04.
// Formato HuJSON (JSON con comentarios y comas finales). Se PEGA a mano en
// https://login.tailscale.com/admin/acls/file  (ver README.md de esta carpeta; no hay API key).
//
// Principios: minimo privilegio, grupos con nombre (nada de autogroup:member), solo los puertos necesarios,
// sin Funnel, y nadie del equipo llega a MySQL ni al anfitrion de Juanita.
{
	// ------------------------------------------------------------------------------------------
	// GRUPOS
	//  - group:biohub-admin  : la dueña del repo (administra las VMs y MySQL).
	//  - group:biohub-equipo : quien usa el backend y mira estado/logs. Incluye a la admin.
	// COMPLETAR: reemplaza los tres marcadores COMPANERO_n por la identidad EXACTA con la que cada
	// compañero inicia sesion en Tailscale (columna "User" en https://login.tailscale.com/admin/machines,
	// p. ej. ana@gmail.com o ana@github). Un marcador sin cambiar no da acceso a nadie: es inofensivo.
	// ------------------------------------------------------------------------------------------
	"groups": {
		"group:biohub-admin":  ["JuaniMP@github"],
		"group:biohub-equipo": [
			"JuaniMP@github",
			"COMPANERO_1-PENDIENTE@invalido.example",  // TODO: correo/identidad del compañero 1
			"COMPANERO_2-PENDIENTE@invalido.example",  // TODO: compañero 2
			"COMPANERO_3-PENDIENTE@invalido.example",  // TODO: compañero 3
		],
	},

	// Quien puede etiquetar nodos con estos tags (al hacer `tailscale up --advertise-tags`).
	// Las VMs YA estan etiquetadas; esto solo importa si hay que volver a registrarlas.
	"tagOwners": {
		"tag:backend": ["autogroup:admin", "group:biohub-admin"],
		"tag:datos":   ["autogroup:admin", "group:biohub-admin"],
	},

	"acls": [
		// El backend (servicios) solo habla con MySQL de la VM de datos.
		{"action": "accept", "src": ["tag:backend"], "dst": ["tag:datos:3307-3310"]},

		// El equipo usa el backend:
		//   443   gateway por HTTPS (tailscale serve)
		//   8443  Keycloak por HTTPS (tailscale serve)
		//   8080, 8180  gateway y Keycloak por HTTP: SOLO mientras el despliegue este en modo HTTP provisional
		//               (sin certificados). ELIMINAR estos dos puertos cuando se active HTTPS (el backend deja
		//               de escucharlos en la tailnet).
		//   15672 panel de RabbitMQ (HTTP, solo lectura de la IP Tailscale)
		//   22    SSH (Tailscale SSH, usuario `equipo`; la regla "ssh" de abajo decide quien y como)
		{"action": "accept", "src": ["group:biohub-equipo"],
		 "dst": ["tag:backend:22,443,8443,8080,8180,15672"]},

		// SSH a la VM de datos (estado y logs con `sudo biohub-estado`). Sin MySQL.
		{"action": "accept", "src": ["group:biohub-equipo"], "dst": ["tag:datos:22"]},

		// MySQL (3307-3310) SOLO la admin: usuarios de aplicacion no (solo aceptan la IP del backend);
		// aqui entra con `lectura_equipo` (solo lectura) o por SSH + root.
		{"action": "accept", "src": ["group:biohub-admin"], "dst": ["tag:datos:3307-3310"]},

		// OPCIONAL (desactivado): dar a todo el equipo consulta de solo lectura (usuario `lectura_equipo`).
		// Descomentar solo si la dueña lo decide; el usuario ya existe y es de solo lectura.
		// {"action": "accept", "src": ["group:biohub-equipo"], "dst": ["tag:datos:3307-3310"]},
	],

	// Tailscale SSH. `check` = reautenticacion en el navegador cada 12 h.
	//  - equipo -> usuario Linux `equipo` (sin sudo, sin docker; solo `sudo biohub-estado ...`)
	//  - solo la admin -> usuario `biohub` (sudo y docker). Nadie mas puede entrar como `biohub` ni `root`.
	"ssh": [
		{"action": "check", "checkPeriod": "12h",
		 "src": ["group:biohub-equipo"], "dst": ["tag:backend", "tag:datos"], "users": ["equipo"]},
		{"action": "check", "checkPeriod": "12h",
		 "src": ["group:biohub-admin"], "dst": ["tag:backend", "tag:datos"], "users": ["biohub"]},
	],

	// PRUEBAS: la consola las evalua al guardar y RECHAZA la politica si alguna falla, asi que un error
	// de tipeo no te deja sin acceso. Si una prueba falla por un detalle de formato, corrige o borra esa
	// prueba (no la politica).
	"tests": [
		{"src": "JuaniMP@github",
		 "accept": ["tag:backend:22", "tag:backend:443", "tag:backend:8443", "tag:backend:15672",
		            "tag:datos:22", "tag:datos:3307", "tag:datos:3310"],
		 "deny":   ["tag:backend:3307", "tag:backend:5672", "tag:backend:8081"]},
		{"src": "tag:backend",
		 "accept": ["tag:datos:3307", "tag:datos:3308", "tag:datos:3309", "tag:datos:3310"],
		 "deny":   ["tag:datos:22", "tag:datos:2375"]},
		{"src": "tag:datos",
		 "deny":   ["tag:backend:22", "tag:backend:443", "tag:backend:8080"]},
		// Descomentar tras completar los correos reales (cambiar el correo de ejemplo):
		// {"src": "COMPANERO_1-PENDIENTE@invalido.example",
		//  "accept": ["tag:backend:443", "tag:backend:8443", "tag:backend:22", "tag:datos:22"],
		//  "deny":   ["tag:datos:3307", "tag:datos:3310", "tag:backend:5672", "100.110.39.21:22"]},
	],

	"sshTests": [
		{"src": "JuaniMP@github", "dst": ["tag:backend", "tag:datos"],
		 "check": ["biohub", "equipo"], "deny": ["root"]},
		// Descomentar tras completar los correos reales:
		// {"src": "COMPANERO_1-PENDIENTE@invalido.example", "dst": ["tag:backend", "tag:datos"],
		//  "check": ["equipo"], "deny": ["biohub", "root"]},
	],
}
