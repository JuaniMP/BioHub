# =============================================================================
# BioHub - VM biohub-backend (gateway, servicios, Keycloak, RabbitMQ, Redis)
# Normalmente NO se edita a mano: deploy/generar-env.sh crea este archivo con
# contraseñas aleatorias y deploy/desplegar.sh rellena TS_IP_* y BIOHUB_TAG.
# Sin ${...}. Solo caracteres [A-Za-z0-9_] en usuarios y contraseñas.
# =============================================================================
COMPOSE_PROJECT_NAME=biohub-backend

# IP de Tailscale (100.x.y.z) de ESTA VM: gateway, Keycloak y panel RabbitMQ se publican solo ahi.
TS_IP_BACKEND=
# IP de Tailscale de biohub-datos: host de MySQL para los servicios.
TS_IP_DATOS=
# Etiqueta de las imagenes biohub/<servicio>:<tag> (la fija desplegar.sh; sirve para rollback)
BIOHUB_TAG=latest

# Puertos de MySQL en biohub-datos
MYSQL_TRANSACCIONAL_PORT=3307
MYSQL_LECTURA_PORT=3308
MYSQL_ANALITICA_PORT=3309
MYSQL_GATEWAY_PORT=3310

# Usuarios de aplicacion MySQL: IDENTICOS a deploy/datos/.env
MYSQL_CIENTIFICO_USER=cientifico_app
MYSQL_CIENTIFICO_PASSWORD=cambiar_cientifico
MYSQL_EQUIPOS_USER=equipos_app
MYSQL_EQUIPOS_PASSWORD=cambiar_equipos
MYSQL_LECTURA_USER=consulta_app
MYSQL_LECTURA_PASSWORD=cambiar_lectura
MYSQL_ANALITICA_USER=reportes_app
MYSQL_ANALITICA_PASSWORD=cambiar_analitica
MYSQL_GATEWAY_USER=gateway_app
MYSQL_GATEWAY_PASSWORD=cambiar_gateway

# Redis (cache de consulta publica; solo red Docker interna)
REDIS_PASSWORD=cambiar_redis

# RabbitMQ: un usuario por servicio (SEC-04) + administrador del panel
RABBITMQ_ADMIN_USER=biohub
RABBITMQ_ADMIN_PASSWORD=cambiar_rabbit_admin
# usuario cientifico_mq
RABBITMQ_CIENTIFICO_PASSWORD=cambiar_rabbit_cientifico
# usuario consulta_mq
RABBITMQ_CONSULTA_PASSWORD=cambiar_rabbit_consulta
# usuario reportes_mq
RABBITMQ_REPORTES_PASSWORD=cambiar_rabbit_reportes

# Keycloak (start-dev, H2): sigue siendo modo desarrollo
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_admin_keycloak
# Contraseña de los usuarios de prueba del realm (minimo 12 caracteres)
KEYCLOAK_TEST_USERS_PASSWORD=cambiar_usuarios_prueba
KEYCLOAK_AUDIENCE=biohub-api

# Origenes CORS permitidos por el gateway (separados por coma)
CORS_ORIGENES=http://localhost:5173,http://localhost:5174
