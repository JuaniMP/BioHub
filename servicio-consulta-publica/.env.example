# =============================================================================
# servicio-consulta-publica - variables de entorno
# Uso:  cp servicio-consulta-publica/.env.example servicio-consulta-publica/.env   (y reemplaza los CAMBIAR)
# El .env real NUNCA se sube al repo (.gitignore). Se lee al ejecutar desde la carpeta del servicio
# (spring.config.import: ../.env de la raíz y luego ./.env, el último gana).
# Sin comentarios al final de línea: Spring lee este archivo como .properties.
# Perfil:  SPRING_PROFILES_ACTIVE=local  (MySQL del docker-compose)  |  =aiven  (MySQL en Aiven)
# =============================================================================

# ---------------- Perfil "local" (usa el .env de la RAÍZ; solo si lo quieres sobrescribir) ----------
# MYSQL_LECTURA_HOST=localhost
# MYSQL_LECTURA_PORT=3308
# MYSQL_LECTURA_USER=consulta_app
# MYSQL_LECTURA_PASSWORD=CAMBIAR

# ---------------- Perfil "aiven" ----------------
# En https://console.aiven.io -> tu servicio MySQL -> Overview -> "Connection information":
#   Host      -> CONSULTA_DB_HOST  (algo como mysql-xxxx-proyecto.a.aivencloud.com)
#   Port      -> CONSULTA_DB_PORT  (NO es 3306: Aiven asigna uno propio, p. ej. 12345)
#   Database  -> CONSULTA_DB_NAME  ("defaultdb" es la que crea Aiven; este proyecto usa la base "consulta_publica")
#   User      -> CONSULTA_DB_USER  (avnadmin es el administrador: solo para crear bases y usuarios;
#                la app debe usar el usuario propio del servicio, p. ej. consulta_app)
#   Password  -> CONSULTA_DB_PASSWORD (la del usuario elegido, pestaña Users)
# No pegues el "Service URI": la app arma la URL JDBC con SSL a partir de estas variables.
# Si la lectura se separa en otro servicio de Aiven, solo cambia el HOST/PORT de esta variable.
CONSULTA_DB_HOST=CAMBIAR.a.aivencloud.com
CONSULTA_DB_PORT=00000
CONSULTA_DB_NAME=consulta_publica
CONSULTA_DB_USER=consulta_app
CONSULTA_DB_PASSWORD=CAMBIAR

# CA de Aiven: en la misma página, "CA certificate" -> Download (ca.pem). Connector/J no lee PEM:
# conviértelo a PKCS12 (comando en docs/equipo/09-despliegue.md, sección Aiven) y pon aquí la ruta ABSOLUTA.
AIVEN_TRUSTSTORE_PATH=/ruta/absoluta/a/certs/aiven-ca.p12
# La que usaste en keytool al convertir (solo letras y números; no es un secreto, protege un certificado público).
AIVEN_TRUSTSTORE_PASSWORD=CAMBIAR
# VERIFY_CA (por defecto) o VERIFY_IDENTITY (además valida el nombre del host). Nunca PREFERRED/REQUIRED.
# AIVEN_SSL_MODE=VERIFY_CA

# Opcional (SEC-11): usuario de migración distinto del de ejecución. Si no se definen, Flyway usa el de arriba.
# CONSULTA_MIGR_USER=consulta_migr
# CONSULTA_MIGR_PASSWORD=CAMBIAR

# Opcional: ajustes del driver hacia Aiven (ms). El timeout de Hikari (3 s) está en application-aiven.yml.
# CONSULTA_DB_CONNECT_TIMEOUT_MS=3000
# CONSULTA_DB_SOCKET_TIMEOUT_MS=30000

# ---------------- Comunes a ambos perfiles ----------------
# Redis, RabbitMQ y Keycloak del docker-compose (valores en el .env de la raíz).
# REDIS_PASSWORD=CAMBIAR
# RABBITMQ_USER=biohub
# RABBITMQ_PASSWORD=CAMBIAR
# Modo degradado (RNF1): ignora los filtros familia y departamento
CONSULTA_MODO_DEGRADADO=false
# Verificar el user_id AMQP del publicador de hallazgo.* (SEC-D-03, SEC-J-01).
# false SOLO en local/pruebas (el servicio avisa con un WARN al arrancar). En cualquier despliegue real debe ser true
# y el publicador de servicio-cientifico debe fijar el user_id AMQP (cientifico_mq).
BIOHUB_EVENTOS_VERIFICAR_PUBLICADOR=false
BIOHUB_EVENTOS_PUBLICADOR_CIENTIFICO=cientifico_mq
