"p523" value="" style="text;" vertex="1" parent="p501"><mxGeometry x="1365" y="200" width="1" height="1" as="geometry"/></mxCell><mxCell id="p524" value="" style="text;" vertex="1" parent="p501"><mxGeometry x="1485" y="200" width="1" height="1" as="geometry"/></mxCell><mxCell id="p525" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=1 3;jumpStyle=arc;jumpSize=8;strokeWidth=1.6;" edge="1" parent="1" source="p523" target="p524"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p526" value="&lt;span style=&quot;font-size:10px&quot;&gt;Comunicación en tiempo de ejecución «HTTP» / «AMQP» (sin importar código)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="p501"><mxGeometry x="1495" y="188" width="380" height="24" as="geometry"/></mxCell><mxCell id="p527" value="&lt;b&gt;cientifico&lt;/b&gt;&lt;span style=&quot;font-size:10px&quot;&gt; [servicio-cientifico]&lt;/span&gt;" style="shape=folder;tabWidth=130;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=22;fontSize=12;" vertex="1" parent="p501"><mxGeometry x="20" y="290" width="1150" height="830" as="geometry"/></mxCell><mxCell id="p528" value="&lt;b&gt;config&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Compartido: SecurityConfig (JWT), RabbitConfig&lt;/span&gt;" style="shape=folder;tabWidth=44;tabHeight=11;tabPosition=left;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacingTop=10;spacing=4;" vertex="1" parent="p527"><mxGeometry x="25" y="50" width="180" height="64" as="geometry"/></mxCell><mxCell id="p529" value="&lt;b&gt;controller&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Compartido: PingController&lt;/span&gt;" style="shape=folder;tabWidth=44;tabHeight=11;tabPosition=left;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacingTop=10;spacing=4;" vertex="1" parent="p527"><mxGeometry x="220" y="50" width="180" height="64" as="geometry"/></mxCell><mxCell id="p530" value="&lt;b&gt;Regla del monorepo:&lt;/b&gt; un módulo no importa las clases internas del otro (&lt;i&gt;controller, domain, infrastructure&lt;/i&gt;). Se comunican por una clase pública de &lt;i&gt;service&lt;/i&gt; o por eventos. Por eso &lt;i&gt;registro&lt;/i&gt; y &lt;i&gt;ubicacion&lt;/i&gt; se conectan a través del paquete compartido &lt;i&gt;eventos&lt;/i&gt; y no dependen directamente entre sí." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="p527"><mxGeometry x="430" y="42" width="700" height="76" as="geometry"/></mxCell><mxCell id="p531" value="&lt;b&gt;registro&lt;/b&gt;&lt;span style=&quot;font-size:10px&quot;&gt; (hallazgos, fichas e historial)&lt;/span&gt;" style="shape=folder;tabWidth=130;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=22;fontSize=12;" vertex="1" parent="p527"><mxGeometry x="20" y="145" width="380" height="640" as="geometry"/></mxCell><mxCell id="p532" value="&lt;b&gt;controller&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Controladores REST de hallazgos, fichas e historial (HU-01, HU-02, HU-03, HU-05)&lt;/span&gt;" style="shape=folder;tabWidth=44;tabHeight=11;tabPosition=left;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacingTop=10;spacing=4;" vertex="1" parent="p531"><mxGeometry x="25.0" y="55" width="330" height="104" as="geometry"/></mxCell><mxCell id="p533" value="&lt;b&gt;service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;ServicioHallazgos, ServicioFichas, ServicioHistorial&lt;/span&gt;" style="shape=folder;tabWidth=44;tabHeight=11;tabPosition=left;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacingTop=10;spacing=4;" vertex="1" parent="p531"><mxGeometry x="25.0" y="200" width="330" height="104" as="geometry"/></mxCell><mxCell id="p534" value="&lt;b&gt;domain&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;&lt;b&gt;«Builder»&lt;/b&gt;&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Hallazgo, Ficha, AtributoDinamico, VersionHallazgo; puertos de repositorio&lt;/span&gt;" style="shape=folder;tabWidth=44;tabHeight=11;tabPosition=left;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacingTop=10;spacing=4;fillColor=#6d8764;strokeColor=#3A5431;fontColor=#ffffff;" vertex="1" parent="p531"><mxGeometry x="25.0" y="345" width="330" height="104" as="geometry"/></mxCell><mxCell id="p535" value="&lt;b&gt;infrastructure&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;RepositorioHallazgosJpa (solo INSERT y SELECT), RepositorioFichasJpa, GestorEvidencias&lt;/span&gt;" style="shape=folder;tabWidth=44;tabHeight=11;tabPosition=left;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacingTop=10;spacing=4;" vertex="1" parent="p531"><mxGeometry x="25.0" y="490" width="330" height="104" as="geometry"/></mxCell><mxCell id="p536" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="p532" target="p533"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p537" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="p533" target="p534"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p538" value="implementa puertos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;endArrow=open;endFill=0;endSize=10;das