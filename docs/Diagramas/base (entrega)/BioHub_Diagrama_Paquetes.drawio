<mxfile host="app.diagrams.net"><diagram id="pkg" name="Diagrama de paquetes"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1950" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p501" value="&lt;b&gt;co.edu.unbosque.biohub&lt;/b&gt;" style="shape=folder;tabWidth=200;tabHeight=24;tabPosition=left;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=22;fontSize=12;opacity=70;textOpacity=85;fontSize=13;spacingTop=26;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="1900" height="1200" as="geometry"/></mxCell><mxCell id="p502" value="&lt;b&gt;web-interna&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;React 19 + Vite · login con Keycloak&lt;/span&gt;" style="shape=folder;tabWidth=44;tabHeight=11;tabPosition=left;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacingTop=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="200" height="62" as="geometry"/></mxCell><mxCell id="p503" value="&lt;b&gt;web-publica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;React 19 + Vite · sin login&lt;/span&gt;" style="shape=folder;tabWidth=44;tabHeight=11;tabPosition=left;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacingTop=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="1120" y="20" width="200" height="62" as="geometry"/></mxCell><mxCell id="p504" value="&lt;b&gt;Los servicios no comparten código&lt;/b&gt; (sin módulo Maven común, decisión D4). Solo se comunican por HTTP a través del gateway o por eventos AMQP en el exchange &lt;i&gt;biohub.eventos&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="p501"><mxGeometry x="25" y="55" width="470" height="70" as="geometry"/></mxCell><mxCell id="