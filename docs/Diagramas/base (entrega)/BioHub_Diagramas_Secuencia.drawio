=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305.0" y="502.0" as="sourcePoint"/><mxPoint x="755.0" y="502.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_07_17" value="" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765.0" y="524.0" as="sourcePoint"/><mxPoint x="771.0" y="542.0" as="targetPoint"/><Array as="points"><mxPoint x="793.0" y="524.0"/><mxPoint x="793.0" y="542.0"/></Array></mxGeometry></mxCell><mxCell id="SD_07_18" value="Resuelve la ruta interna por el&lt;br&gt;prefijo /api/publica" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="798.0" y="515.0" width="190.0" height="34.0" as="geometry"/></mxCell><mxCell id="SD_07_19" value="GET /api/publica/especies (red interna)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765.0" y="575.0" as="sourcePoint"/><mxPoint x="985.0" y="575.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_07_20" value="200 OK (fichas con ubicación generalizada)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985.0" y="602.0" as="sourcePoint"/><mxPoint x="765.0" y="602.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_07_21" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755.0" y="629.0" as="sourcePoint"/><mxPoint x="305.0" y="629.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_07_22" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295.0" y="656.0" as="sourcePoint"/><mxPoint x="110.0" y="656.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_07_23" value="Las API Keys se guardan solo como hash. El consumidor conoce únicamente la URL pública del gateway: si los servidores internos se migran, solo cambian las rutas internas del ProxyService (ASR9). El exceso de peticiones se corta en el gateway, antes de llegar a cualquier servicio (ASR8)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fontSize=9.5;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="225.0" y="702.0" width="855.0" height="46.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sd8" name="SD-08 Reporte mensual"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1442" pageHeight="1299" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="SD_08_frame" value="sd SD-08 Generación del reporte mensual (HU-09)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=302;height=20;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="7.5" y="10" width="1415.0" height="1269.0" as="geometry"/></mxCell><mxCell id="SD_08_39" value="par" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=48;height=20;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55.0" y="398.0" width="1330.0" height="543.0" as="geometry"/></mxCell><mxCell id="SD_08_40" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=20;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="67.0" y="681.0" width="1306.0" height="244.0" as="geom