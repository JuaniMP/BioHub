as públicas" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975.0" y="599.0" as="sourcePoint"/><mxPoint x="1309.0" y="599.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_05_20" value="Fichas" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1309.0" y="626.0" as="sourcePoint"/><mxPoint x="975.0" y="626.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_05_21" value="SET clave (con tiempo de expiración)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975.0" y="653.0" as="sourcePoint"/><mxPoint x="1142.0" y="653.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_05_22" value="Fichas con región o departamento" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965.0" y="696.0" as="sourcePoint"/><mxPoint x="803.0" y="696.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_05_23" value="Resultados" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="793.0" y="723.0" as="sourcePoint"/><mxPoint x="631.0" y="723.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_05_24" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="621.0" y="750.0" as="sourcePoint"/><mxPoint x="459.0" y="750.0" as="targetPoi