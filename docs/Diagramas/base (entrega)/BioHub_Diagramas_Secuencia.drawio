int"/></mxGeometry></mxCell><mxCell id="SD_09_26" value="No se modifica el esquema de la base de datos ni el código. Los hallazgos ya registrados conservan la versión de plantilla con la que se guardaron, por lo que no se alteran (ASR5, HU-02 criterio 3)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fontSize=9.5;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590.0" y="804.0" width="705.0" height="46.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>