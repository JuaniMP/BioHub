ckgroundColor=default;" vertex="1" parent="1"><mxGeometry x="235.0" y="459.0" width="360.0" height="18.0" as="geometry"/></mxCell><mxCell id="SD_04_14" value="Rechaza el mensaje (sin reencolar)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505.0" y="495.0" as="sourcePoint"/><mxPoint x="310.0" y="495.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_04_15" value="" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="517.0" as="sourcePoint"/><mxPoint x="315.0" y="535.0" as="targetPoint"/><Array as="points"><mxPoint x="338.0" y="517.0"/><mxPoint x="338.0" y="535.0"/></Array></mxGeometry></mxCell><mxCell id="SD_04_16" value="Lo envía a la cola de mensajes&lt;br&gt;muertos (DLQ) para revisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="343.0" y="508.0" width="180.0" height="34.0" as="geometry"/></mxCell><mxCell id="SD_04_17" value="" style="endArrow=none;dashed=1;dashPattern=6 4;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215.0" y="577.0" as="sourcePoint"/><mxPoint x="1300.0" y="577.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_04_18" value="&lt;b&gt;[cola de Reportes]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=9.5;labelBackgroundColor=default;" vertex="1" parent="1"><mxGeometry x="223.0" y="578.0" width="360.0" height="18.0" as="geometry"/></mxCell><mxCell id="SD_04_19" value="Entrega el evento" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="614.0" as="sourcePoint"/><mxPoint x="1030.0" y="614.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_04_20" value="Inserta el registro analítico" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040.0" y="641.0" as="sourcePoint"/><mxPoint x="1200.0" y="641.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_04_21" value="OK" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="668.0" as="sourcePoint"/><mxPoint x="1040.0" y="668.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_04_22" value="ack" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;fontSize=9.5;rounded=0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030.0" y="695.0" as="sourcePoint"/><mxPoint x="310.0" y="695.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD_04_23" value="Cada servicio consume a su propio ritmo desde su cola. Si la Consulta Pública o los Reportes están caídos o lentos, los mensajes esperan en su cola y el registro científico no se ve afectado (ASR2, ASR3). La caché se invalida para que la siguiente consulta lea los datos actualizados (ASR4)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fontSize=9.5;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="731.0" width="1255.0" height="46.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sd5" name="SD-05 Consulta publica"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1456" pageHeight="953" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="SD_05_frame" value="sd SD-05 Consulta pública de una espe