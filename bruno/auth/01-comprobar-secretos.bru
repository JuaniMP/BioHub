meta {
  name: 00-comprobar-secretos
  type: http
  seq: 1
}

get {
  url: {{keycloakUrl}}/realms/{{realm}}/.well-known/openid-configuration
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getEnvVar("passwordUsuarios") || !bru.getEnvVar("rabbitPassword")) {
    throw new Error("Faltan passwordUsuarios / rabbitPassword: pasa --env-var passwordUsuarios=... --env-var rabbitPassword=...");
  }
}

tests {
  test("Keycloak responde con el issuer del realm", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().issuer).to.match(/\/realms\/biohub$/);
  });
}

docs {
  Precondición de toda la colección: Keycloak levantado con el realm `biohub` y los secretos presentes.
  Requisito: RF18 (autenticación previa a lo interno).
}
