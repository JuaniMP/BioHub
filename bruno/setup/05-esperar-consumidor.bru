meta {
  name: esperar-consumidor
  type: http
  seq: 5
}

get {
  url: {{baseConsulta}}/actuator/health
  body: none
  auth: none
}

script:pre-request {
  // Los eventos se procesan de forma asíncrona: damos tiempo al consumidor.
  await bru.sleep(4000);
}

tests {
  test("consulta-publica sana", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("UP");
  });
}

docs {
  Pausa para que el consumidor procese los eventos sembrados. Requisito: RNF5 (servicio sano).
}
