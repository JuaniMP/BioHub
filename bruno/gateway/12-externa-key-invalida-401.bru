}

tests {
  test("una key inventada no entra", function () {
    expect(res.getStatus()).to.equal(401);
  });
  test("codigo API_KEY_INVALIDA", function () {
    expect(res.getBody().codigo).to.equal("API_KEY_INVALIDA");
  });
}

