meta {
  name: listar-keys-sin-secreto
  type: http
  seq: 10
}

get {
  url: {{baseGateway}}/api/gateway/consumidores/{{consumidorId}}/keys
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_admin}}
}

tests {
  test("lista las keys", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("nunca devuelve la key ni su hash", function () {
    const texto = JSON.stringify(res.getBody());
    expect(texto).to.not.contain(bru.getVar("apiKey"));
    expect(texto).to.not.contain("hash");
  });
}

docs {
  Requisito: HU-12, SEC.
}
