meta {
  name: ficha-por-id
  type: http
  seq: 9
}

get {
  url: {{baseConsulta}}/api/publica/fichas/{{hallazgoA}}
  body: none
  auth: none
}

tests {
  // Busca en cualquier nivel claves de coordenadas (sin distinguir mayúsculas). Devuelve las halladas.
  function clavesDeCoordenadas(o, hallado) {
    hallado = hallado || [];
    const prohibidas = ["latitud", "longitud", "lat", "lon", "lng", "coordenadas", "coordinates", "geometry", "geom", "ubicacionexacta"];
    if (Array.isArray(o)) { o.forEach(function (x) { clavesDeCoordenadas(x, hallado); }); }
    else if (o && typeof o === "object") {
      Object.keys(o).forEach(function (k) {
        if (prohibidas.indexOf(k.toLowerCase()) >= 0) { hallado.push(k); }
        clavesDeCoordenadas(o[k], hallado);
      });
    }
    return hallado;
  }
  test("200 con la ficha completa", function () {
    expect(res.getStatus()).to.equal(200);
    const f = res.getBody();
    expect(f.id).to.equal(bru.getEnvVar("hallazgoA"));
    expect(f.nombreCientifico).to.equal("Atelopus ebenoides");
    expect(f).to.include.keys(["nombreComun", "familia", "tipoEspecimen", "fechaRecoleccion", "estadoConservacion", "departamento", "departamentoCodigo", "region", "descripcion", "ubicacionProtegida"]);
    expect(f.estadoConservacion).to.equal("EN_PELIGRO");
    expect(f.departamentoCodigo).to.equal("15");
  });
  test("ubicacionProtegida es siempre true", function () {
    expect(res.getBody().ubicacionProtegida).to.equal(true);
  });
  test("sin datos del investigador", function () {
    expect(res.getBody()).to.not.have.any.keys("investigador", "usuario");
  });
  test("Cache-Control public, max-age=60", function () {
    expect(res.getHeader("cache-control")).to.equal("public, max-age=60");
  });
  test("responde en <= 2 s (RNF5)", function () {
    expect(res.getResponseTime()).to.be.below(2000);
  });
  test("la respuesta NUNCA contiene claves de coordenadas (D14)", function () {
    expect(clavesDeCoordenadas(res.getBody())).to.deep.equal([]);
    const crudo = JSON.stringify(res.getBody());
    expect(crudo).to.not.contain("5.1234567");
    expect(crudo).to.not.contain("-73.1234567");
  });
}

docs {
  Ficha pública: muestra departamento/región, nunca coordenadas.
  Requisito: RF10, RF11, HU-06.3, RNF5 (ASR4), RNF9.
}
