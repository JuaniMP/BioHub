# =============================================================================
# servicio-reportes - variables de entorno
# Uso:  cp servicio-reportes/.env.example servicio-reportes/.env   (y reemplaza los CAMBIAR)
# El .env real NUNCA se sube al repo (.gitignore). Se lee al ejecutar desde la carpeta del servicio
# (spring.config.import: ../.env de la raíz y luego ./.env, el último gana).
# Sin comentarios al final de línea: Spring lee este archivo como .properties.
# Perfil:  SPRING_PROFILES_ACTIVE=local  (MySQL del docker-compose)  |  =aiven  (MySQL en Aiven)
# Sin perfil el servicio NO arranca (no hay URL por defecto); sin él, define REPORTES_DB_URL completa.
# =============================================================================

# ---------------- Perfil "local" (usa el .env de la RAÍZ; solo si lo quieres sobrescribir) ----------
# MYSQL_ANALITICA_HOST=localhost
# MYSQL_ANALITICA_PORT=3309
# MYSQL_ANALITICA_USER=reportes_app
# MYSQL_ANALITICA_PASSWORD=CAMBIAR

# ---------------- Perfil "aiven" ----------------
# Esta base vive en el servicio de Aiven de LECTURA (D39; guía paso a paso en docs/equipo/09-despliegue.md §4).
# En https://console.aiven.io -> el servicio MySQL de lectura -> Overview -> "Connection information":
#   Host      -> REPORTES_DB_HOST  (algo como mysql-xxxx-proyecto.a.aivencloud.com)
#   Port      -> REPORTES_DB_PORT  (NO es 3306: Aiven asigna uno propio, p. ej. 12345)
#   Database  -> REPORTES_DB_NAME  ("defaultdb" es la que crea Aiven; este proyecto usa la base "reportes")
#   User      -> REPORTES_DB_USER  (avnadmin es el administrador: solo para crear bases y usuarios;
#                la app debe usar el usuario propio del servicio: reportes_app)
#   Password  -> REPORTES_DB_PASSWORD (la que quedó al ejecutar deploy/aiven/02-lectura-bases-y-usuarios.sql.example)
# No pegues el "Service URI": la app arma la URL JDBC con SSL a partir de estas variables.
REPORTES_DB_HOST=CAMBIAR.a.aivencloud.com
REPORTES_DB_PORT=00000
REPORTES_DB_NAME=reportes
REPORTES_DB_USER=reportes_app
REPORTES_DB_PASSWORD=CAMBIAR

# CA de Aiven: en la misma página, "CA certificate" -> Download (ca.pem). Connector/J no lee PEM:
# conviértelo a PKCS12 (comando en docs/equipo/09-despliegue.md, sección Aiven) y pon aquí la ruta ABSOLUTA.
AIVEN_TRUSTSTORE_PATH=/ruta/absoluta/a/certs/aiven-ca.p12
# La que usaste en keytool al convertir (solo letras y números; no es un secreto, protege un certificado público).
AIVEN_TRUSTSTORE_PASSWORD=CAMBIAR
# VERIFY_CA (por defecto) o VERIFY_IDENTITY (además valida el nombre del host). Nunca PREFERRED/REQUIRED.
# AIVEN_SSL_MODE=VERIFY_CA

# Usuario de migración (SEC-11): en Aiven, reportes_app solo tiene DML y Flyway necesita DDL, así que define estas dos.
# Si no se definen, Flyway usa el usuario de arriba y falla por falta de CREATE.
REPORTES_MIGR_USER=reportes_migr
REPORTES_MIGR_PASSWORD=CAMBIAR

# Opcional: ajustes del driver hacia Aiven (ms). El timeout de Hikari (10 s) está en application-aiven.yml.
# REPORTES_DB_CONNECT_TIMEOUT_MS=3000
# REPORTES_DB_SOCKET_TIMEOUT_MS=30000

# ---------------- Comunes a ambos perfiles ----------------
# Keycloak (y RabbitMQ si el servicio lo usa) del docker-compose: valores en el .env de la raíz.
