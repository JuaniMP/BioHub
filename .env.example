# =============================================================================
# BioHub - variables de entorno (desarrollo local)
# Copia este archivo:  cp .env.example .env   y CAMBIA todas las contraseñas.
# El .env real NUNCA se sube al repo (está en .gitignore).
# Los servicios Spring Boot también leen este archivo (spring.config.import).
# No uses ${...} dentro de este archivo: Spring y Compose lo leen distinto.
# =============================================================================
COMPOSE_PROJECT_NAME=biohub

# --- MySQL transaccional (esquemas "cientifico" y "equipos", un usuario por esquema)
MYSQL_TRANSACCIONAL_HOST=localhost
MYSQL_TRANSACCIONAL_PORT=3307
MYSQL_TRANSACCIONAL_ROOT_PASSWORD=cambiar_root_transaccional
MYSQL_CIENTIFICO_USER=cientifico_app
MYSQL_CIENTIFICO_PASSWORD=cambiar_cientifico
MYSQL_EQUIPOS_USER=equipos_app
MYSQL_EQUIPOS_PASSWORD=cambiar_equipos

# --- MySQL de lectura (servicio-consulta-publica)
MYSQL_LECTURA_HOST=localhost
MYSQL_LECTURA_PORT=3308
MYSQL_LECTURA_ROOT_PASSWORD=cambiar_root_lectura
MYSQL_LECTURA_USER=consulta_app
MYSQL_LECTURA_PASSWORD=cambiar_lectura

# --- MySQL analítica (servicio-reportes)
MYSQL_ANALITICA_HOST=localhost
MYSQL_ANALITICA_PORT=3309
MYSQL_ANALITICA_ROOT_PASSWORD=cambiar_root_analitica
MYSQL_ANALITICA_USER=reportes_app
MYSQL_ANALITICA_PASSWORD=cambiar_analitica

# --- MySQL gateway (API Keys y límites)
MYSQL_GATEWAY_HOST=localhost
MYSQL_GATEWAY_PORT=3310
MYSQL_GATEWAY_ROOT_PASSWORD=cambiar_root_gateway
MYSQL_GATEWAY_USER=gateway_app
MYSQL_GATEWAY_PASSWORD=cambiar_gateway

# --- Redis (caché de consulta pública)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cambiar_redis

# --- RabbitMQ (eventos asíncronos)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=biohub
RABBITMQ_PASSWORD=cambiar_rabbit

# --- Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_admin_keycloak
# Contraseña de los 5 usuarios de prueba del realm (se inyecta al importar el realm)
KEYCLOAK_TEST_USERS_PASSWORD=cambiar_usuarios_prueba
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/biohub
KEYCLOAK_AUDIENCE=biohub-api

# --- Puertos de los servicios
API_GATEWAY_PORT=8080
SERVICIO_CIENTIFICO_PORT=8081
SERVICIO_EQUIPOS_PORT=8082
SERVICIO_CONSULTA_PUBLICA_PORT=8083
SERVICIO_REPORTES_PORT=8084
