# =============================================================================
# BioHub - variables de entorno (desarrollo local)
# Copia este archivo:  cp .env.example .env   y CAMBIA todas las contraseñas.
# El .env real NUNCA se sube al repo (está en .gitignore).
# Los servicios Spring Boot también leen este archivo (spring.config.import).
# No uses ${...} dentro de este archivo: Spring y Compose lo leen distinto.
# =============================================================================
COMPOSE_PROJECT_NAME=biohub

# --- MySQL transaccional (esquemas "cientifico" y "equipos", un usuario por esquema)
MYSQL_TRANSACCIONAL_HOST=localhost
MYSQL_TRANSACCIONAL_PORT=3307
MYSQL_TRANSACCIONAL_ROOT_PASSWORD=cambiar_root_transaccional
MYSQL_CIENTIFICO_USER=cientifico_app
MYSQL_CIENTIFICO_PASSWORD=cambiar_cientifico
MYSQL_EQUIPOS_USER=equipos_app
MYSQL_EQUIPOS_PASSWORD=cambiar_equipos

# --- MySQL de lectura (servicio-consulta-publica)
MYSQL_LECTURA_HOST=localhost
MYSQL_LECTURA_PORT=3308
MYSQL_LECTURA_ROOT_PASSWORD=cambiar_root_lectura
MYSQL_LECTURA_USER=consulta_app
MYSQL_LECTURA_PASSWORD=cambiar_lectura

# --- MySQL analítica (servicio-reportes)
MYSQL_ANALITICA_HOST=localhost
MYSQL_ANALITICA_PORT=3309
MYSQL_ANALITICA_ROOT_PASSWORD=cambiar_root_analitica
MYSQL_ANALITICA_USER=reportes_app
MYSQL_ANALITICA_PASSWORD=cambiar_analitica

# --- MySQL gateway (API Keys y límites)
MYSQL_GATEWAY_HOST=localhost
MYSQL_GATEWAY_PORT=3310
MYSQL_GATEWAY_ROOT_PASSWORD=cambiar_root_gateway
MYSQL_GATEWAY_USER=gateway_app
MYSQL_GATEWAY_PASSWORD=cambiar_gateway

# --- Aiven (perfil "aiven"; en el perfil "local" todo este bloque se ignora) ---------------------------
# D39: DOS servicios MySQL en Aiven y cada servicio apunta al suyo con su propio HOST/PORT:
#   ESCRITURA (servicio de Aiven 1): bases cientifico y equipos
#   LECTURA   (servicio de Aiven 2): bases consulta_publica, reportes y gateway
# Cada integrante rellena SOLO lo de su(s) servicio(s); host y puerto salen de la consola de Aiven
# (servicio -> Overview -> Connection information; el puerto NO es 3306). Usuario y contraseña de cada
# base (los de deploy/aiven/0X-*.sql) van mejor en el .env de la carpeta del servicio, ver su .env.example
# (CIENTIFICO_DB_USER/PASSWORD, EQUIPOS_..., CONSULTA_..., REPORTES_..., GATEWAY_..., y *_MIGR_USER/PASSWORD).
# Guia completa: docs/equipo/09-despliegue.md seccion 4. Descomenta y completa solo lo que uses.
#
# Servicio de ESCRITURA
# CIENTIFICO_DB_HOST=CAMBIAR.a.aivencloud.com
# CIENTIFICO_DB_PORT=00000
# EQUIPOS_DB_HOST=CAMBIAR.a.aivencloud.com
# EQUIPOS_DB_PORT=00000
# Servicio de LECTURA
# CONSULTA_DB_HOST=CAMBIAR.a.aivencloud.com
# CONSULTA_DB_PORT=00000
# REPORTES_DB_HOST=CAMBIAR.a.aivencloud.com
# REPORTES_DB_PORT=00000
# GATEWAY_DB_HOST=CAMBIAR.a.aivencloud.com
# GATEWAY_DB_PORT=00000
# Truststore PKCS12 con el CA de Aiven. Cada proyecto de Aiven tiene su propio CA: como los dos servicios estan
# en cuentas distintas, el truststore lleva AMBOS ca.pem (alias distintos); ver 09-despliegue.md 4.5. Ruta ABSOLUTA.
# AIVEN_TRUSTSTORE_PATH=/ruta/absoluta/a/certs/aiven-ca.p12
# AIVEN_TRUSTSTORE_PASSWORD=CAMBIAR
# AIVEN_SSL_MODE=VERIFY_CA

# --- Redis (caché de consulta pública)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cambiar_redis

# --- RabbitMQ (eventos asíncronos)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=biohub
RABBITMQ_PASSWORD=cambiar_rabbit

# --- Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar_admin_keycloak
# Contraseña de los 5 usuarios de prueba del realm (se inyecta al importar el realm)
KEYCLOAK_TEST_USERS_PASSWORD=cambiar_usuarios_prueba
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/biohub
KEYCLOAK_AUDIENCE=biohub-api

# --- Puertos de los servicios
API_GATEWAY_PORT=8080
SERVICIO_CIENTIFICO_PORT=8081
SERVICIO_EQUIPOS_PORT=8082
SERVICIO_CONSULTA_PUBLICA_PORT=8083
SERVICIO_REPORTES_PORT=8084

# --- servicio-consulta-publica (todas opcionales; valores por defecto entre paréntesis)
# Modo degradado (RNF1): si es true se ignoran los filtros familia y departamento (false)
CONSULTA_MODO_DEGRADADO=false
# Verificar el user_id AMQP del publicador de hallazgo.* (ARQ-13, SEC-J-01, SEC-J-11). true por defecto: un evento sin
# user_id, o con uno distinto del esperado, va a la DLQ. false SOLO en pruebas locales sin publicador (el servicio avisa
# con un WARN). servicio-cientifico fija user_id = RABBITMQ_USER en cada evento (PublicadorEventos).
BIOHUB_EVENTOS_VERIFICAR_PUBLICADOR=true
# Usuario AMQP esperado del publicador: debe ser el usuario con que publica servicio-cientifico. En el Compose de
# desarrollo todos los servicios usan RABBITMQ_USER (biohub), asi que debe valer lo mismo que RABBITMQ_USER; si no, todo
# evento de cientifico se rechaza. cientifico_mq solo aplica cuando existan usuarios AMQP por servicio (SEC-04).
BIOHUB_EVENTOS_PUBLICADOR_CIENTIFICO=biohub
